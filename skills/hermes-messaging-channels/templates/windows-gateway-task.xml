<?xml version="1.0" encoding="UTF-16"?>
<!--
  Hermes gateway autostart + watchdog for Windows.

  Substitute before registering:
    <UserId>            DOMAIN_OR_HOST\username     (both occurrences)
    <Arguments>         absolute path to the gateway launcher Hermes installed under HERMES_HOME
    <WorkingDirectory>  absolute HERMES_HOME
    <URI>               keep in sync with the /TN you register under

  Register with:
    schtasks /Create /TN "HermesGateway" /XML "<path-to-this-file>" /F

  Why XML and not the PowerShell cmdlets: an indefinite <Repetition> cannot be
  expressed via New-ScheduledTaskTrigger — RepetitionDuration=[TimeSpan]::MaxValue
  serialises to P99999999DT23H59M59S and Register-ScheduledTask rejects it.
  Omitting <Duration> here is what means "forever".

  Safe to run against a live gateway: a second start detects the running one and
  exits (or attaches) without killing it or duplicating the long poll.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Starts the Hermes gateway (messaging channels) at logon and re-checks every 15 min. Idempotent: exits cleanly if a gateway is already running.</Description>
    <URI>\HermesGateway</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>DOMAIN\username</UserId>
      <!-- let the network settle before the first Telegram connect -->
      <Delay>PT45S</Delay>
      <!-- the watchdog: no <Duration> == repeat forever.
           This is the part that fixes a gateway dying mid-day, which a
           logon-only trigger cannot cover. -->
      <Repetition>
        <Interval>PT15M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>DOMAIN\username</UserId>
      <!-- InteractiveToken + LeastPrivilege: no admin, no UAC prompt -->
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <!-- catch up if the machine was asleep at trigger time -->
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <DisallowStartOnRemoteAppSession>false</DisallowStartOnRemoteAppSession>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
    <WakeToRun>false</WakeToRun>
    <!-- PT0S == no time limit. A default limit would kill the long-lived gateway. -->
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT2M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <!-- Point at the INTERNAL gateway-service VBS, not the Start Menu copy:
           it already exports HERMES_HOME / VIRTUAL_ENV / PYTHONPATH /
           PYTHONIOENCODING and launches detached. -->
      <Command>C:\WINDOWS\System32\wscript.exe</Command>
      <Arguments>C:\Users\username\AppData\Local\hermes\gateway-service\Hermes_Gateway.vbs</Arguments>
      <WorkingDirectory>C:\Users\username\AppData\Local\hermes</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
